        "actual_outcome",
        "ground_truth",
        "strict_success",
        "judge_score",
        "judge_reason",
        "split_name"
      ],
      "method": [
        "method",
        "attack_method",
        "attack_method_name",
        "attack_technique",
        "attack_template"
      ],
      "raw": [
        "raw",
        "raw_payload",
        "raw_prompt",
        "attack_text",
        "harmful_request",
        "target_response",
        "system_prompt"
      ]
    }
  },
  "provenance_contract": {
