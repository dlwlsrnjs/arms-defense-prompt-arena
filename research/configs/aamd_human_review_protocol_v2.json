  "proposal_contract": {
    "first_pass_labeler": {
      "config_id": "aamd-llm-first-labeler-32b-v1",
      "model_id": "Qwen/Qwen2.5-VL-32B-Instruct",
      "parameters": "32B",
      "model_revision": "7cfb30d71a1f4f49a57592323337a4a4727301da",
      "model_revision_status": "candidate_needs_G0_attestation",
      "prompt_template_hash": "cfad4c64a0f0afa97db52b779e29f86220df6fd8b6a7fb6f5989f1d8bf27eab2",
      "decoding_config_hash": "3725e1f6f82d2a4b469375f668431fd7c406314f0e3b57ac6d02b7af9e887add",
      "claim_bearing_requires_revision_status": "g0_attested",
      "trusted_g0_attestation_sha256": null,
      "trusted_claim_bundle_sha256": null,
      "bundle_self_assertion_sufficient": false
    },
    "generation_mode": "offline",
    "release_status": "available_in_role_authorized_task_view_before_human_review",
    "frozen_before_assignment": true,
    "immutable_after_bundle_approval": true,
    "runtime_model_calls_allowed": false,
    "content_addressed_by": "proposal_hash",
    "same_proposal_hash_required_for_roles": [
      "primary",
      "secondary"
    ],
    "proposal_is_ground_truth": false
  },
  "event_chain": {
    "chain_version": "aamd-stage-chain-v2",
    "legacy_stages_disabled": [
      "initial",
      "reveal"
    ],
    "stages": [
      {
        "stage": "final",
        "actor_role": "primary",
        "expected_version": 0,
        "previous_stage": null,
        "previous_event_hash": "GENESIS"
      },
      {
        "stage": "secondary",
        "actor_role": "secondary",
        "expected_version": 1,
        "previous_stage": "final",
        "previous_event_hash": "final.event_hash"
      },
      {
        "stage": "adjudicate",
        "actor_role": "adjudicator",
        "expected_version": 2,
        "previous_stage": "secondary",
        "previous_event_hash": "secondary.event_hash"
      }
    ]
  },
  "review_contract": {
    "decisions": [
      "accept",
      "edit",
      "reject",
      "abstain"
    ],
    "decision_invariants": {
      "accept": "judgment_equals_frozen_proposal",
      "edit": "non_abstaining_judgment_differs_from_frozen_proposal",
      "reject": "non_abstaining_replacement_differs_from_frozen_proposal",
      "abstain": "judgment_abstain_is_true"
    },
    "primary_and_secondary_must_be_distinct": true,
    "adjudicator_must_be_distinct_from_both_reviewers": true,
    "secondary_requires_locked_stage": "final",
    "adjudication_requires_locked_stage": "secondary",
    "prior_events_are_append_only": true
  },
  "visibility_contract": {
    "primary_proposal_visible": true,
    "secondary_proposal_visible": true,
    "primary_and_secondary_receive_identical_proposal_hash": true,
    "secondary_can_see_primary_vote": false,
    "secondary_response_must_omit": [
      "primary_vote",
      "final.payload",
      "final.receipt"
    ],
    "secondary_receipt_may_include_opaque_previous_event_hash_after_lock": true,
    "adjudicator_can_see": [
      "frozen_proposal",
      "primary_final_vote",
      "secondary_vote"
    ],
    "masking_applies_to": [
      "bundle_ingress",
      "stored_task",
      "stored_proposal",
      "reviewer_views",
      "admin_export"
    ],
    "masked_field_families": {
