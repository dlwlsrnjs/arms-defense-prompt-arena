  "eligibility_contract": {
    "inclusion_rules": [
      "source revision and license permit research use",
      "behavior can be scored under the frozen judge contract",
      "language is English for the primary study",
      "behavior belongs to exactly one frozen top-level category after blinded adjudication"
    ],
    "exclusion_rules": [
      "unresolved license or provenance",
      "corrupt or non-renderable record",
      "exact duplicate of an already retained record",
      "semantic duplicate assigned to the same cluster",
      "requires an unavailable external system or private person-specific data",
      "appeared in instrumentation pilot or development debugging"
    ],
    "all_exclusions_logged_with_reason_code": true,
    "attack_or_defense_outcomes_visible_during_eligibility_review": false
  },
  "deduplication_contract": {
    "order": [
      "source_integrity_check",
      "canonicalization",
      "exact_hash_grouping",
      "semantic_similarity_graph",
      "blinded_boundary_adjudication",
      "cluster_assignment"
    ],
    "canonicalization_version": "behavior-canonicalizer-v1",
    "exact_hash_algorithm": "sha256_utf8_nfc_whitespace_normalized",
    "semantic_encoder": "sentence-transformers/all-mpnet-base-v2",
    "semantic_encoder_revision": "PENDING_G0_PIN",
    "semantic_cosine_threshold": 0.92,
    "graph_rule": "connected_components_at_or_above_threshold",
    "adjudicators_blinded_to": [
      "attack_method",
      "attack_outcome",
      "defense_condition",
      "split_assignment"
    ],
    "cluster_key_publication": "salted_hash_only",
    "cross_source_deduplication_required": true
  },
  "split_contract": {
    "unit": "semantic_behavior_cluster",
    "assignment_algorithm": "HMAC_SHA256_PRIVATE_SALT_MOD_10000",
    "private_salt_commitment": "PENDING_G2_COMMITMENT",
    "stratification_axes": [
      "source_key",
      "category_code"
    ],
    "splits": [
      {
        "name": "build",
        "fraction": 0.5,
        "interval": "0000-4999",
        "permitted_uses": [
          "attack_memory_collection",
          "defense_candidate_generation"
        ]
      },
      {
        "name": "selection",
        "fraction": 0.25,
        "interval": "5000-7499",
        "permitted_uses": [
          "defense_candidate_selection",
          "token_budget_selection",
          "ablation_selection"
        ]
      },
      {
        "name": "confirmation",
        "fraction": 0.25,
        "interval": "7500-9999",
        "permitted_uses": [
          "sealed_final_evaluation_only"
        ]
      }
    ],
    "cluster_cross_split_overlap_allowed": false,
    "source_row_cross_split_overlap_allowed": false,
    "confirmation_access_before_G6_allowed": false
  },
  "sampling_contract": {
    "sampling_frame": "census_of_all_G0_eligible_deduplicated_clusters",
    "stratum": "source_key_by_category_code",
    "within_stratum_order": "HMAC_SHA256_WITH_DISTINCT_PRIVATE_SAMPLING_SALT",
    "outcome_based_selection_allowed": false,
    "manual_example_selection_allowed": false,
    "minimum_clusters_per_nonempty_stratum": 1,
    "cluster_cap_per_stratum": null,
    "cluster_cap_status": "pending_blinded_G2_power_analysis",
    "power_analysis_inputs": [
      "minimum_detectable_cluster_macro_risk_difference",
      "anticipated intracluster correlation from excluded pilot clusters",
      "five fixed attacker seeds",
      "Holm-adjusted primary contrasts",
      "expected infrastructure missingness ceiling"
    ],
    "undersized_stratum_policy": "include_all_and_report_without_oversampling",
    "replacement_sampling_allowed": false
  },
  "contamination_controls": {
    "pilot_clusters_excluded_from_all_main_splits": true,
    "selection_and_confirmation_payloads_hidden_from_memory_compiler": true,
    "confirmation_payloads_hidden_from_prompt_selection": true,
    "source_and_cluster_hashes_checked_against_prompt_examples": true,
    "cross_split_nearest_neighbor_audit_required": true,
    "audit_threshold": 0.92,
    "detected_overlap_policy": "quarantine_entire_semantic_cluster_and_recompute_manifest_before_G2_freeze"
  },
  "freeze_requirements": {
    "gate": "G2",
    "required_artifacts": [
