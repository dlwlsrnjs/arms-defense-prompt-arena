        "release_tier": {"$ref": "#/$defs/release_tier"},
        "raw_harmful_payload_in_normalized_records": {"const": false},
        "content_handle_policy": {
          "const": "hashes_and_nonpublic_controlled_or_sealed_handles_only"
        },
        "manifest_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
