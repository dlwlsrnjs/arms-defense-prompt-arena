{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dlwlsrnjs.github.io/arms-defense-prompt-arena/schemas/adaptive-attack-memory-record-v1.schema.json",
  "title": "AAMD-v1 payload-free normalized record",
  "description": "Strict public record contract for prospective AAMD-v1 collection. Operational attack content, raw target responses, raw annotation rationales, and system-prompt text are excluded; only content-addressed hashes and controlled or sealed handles are permitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "record_type",
    "record_id",
    "run_id",
    "event_id",
    "created_at",
    "event_hash",
    "previous_event_hash",
    "source_manifest_hash",
    "release_tier",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "adaptive-attack-memory-record-v1"
    },
    "dataset_id": {
      "const": "adaptive-attack-memory-dataset-v1"
    },
    "record_type": {
      "enum": [
        "episode",
        "turn",
        "adaptation_transition",
        "memory_candidate",
        "memory_write_decision",
        "memory_retrieval",
        "memory_use_receipt",
        "annotation_event",
        "attack_counterfactual_trial",
        "defense_affordance",
        "defense_validation_trial",
        "artifact_manifest"
      ]
    },
    "record_id": {
      "$ref": "#/$defs/id"
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "event_id": {
      "$ref": "#/$defs/id"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "event_hash": {
      "$ref": "#/$defs/sha256"
    },
    "previous_event_hash": {
      "$ref": "#/$defs/nullable_sha256"
    },
    "source_manifest_hash": {
      "$ref": "#/$defs/sha256"
    },
    "release_tier": {
      "$ref": "#/$defs/release_tier"
    },
    "payload": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["record_type", "payload"],
      "properties": {
        "record_type": {"const": "episode"},
        "payload": {"$ref": "#/$defs/episode_payload"}
      }
    },
    {
      "type": "object",
      "required": ["record_type", "payload"],
      "properties": {
        "record_type": {"const": "turn"},
        "payload": {"$ref": "#/$defs/turn_payload"}
      }
    },
    {
      "type": "object",
      "required": ["record_type", "payload"],
      "properties": {
        "record_type": {"const": "adaptation_transition"},
        "payload": {"$ref": "#/$defs/adaptation_transition_payload"}
      }
    },
    {
      "type": "object",
      "required": ["record_type", "payload"],
      "properties": {
        "record_type": {"const": "memory_candidate"},
        "payload": {"$ref": "#/$defs/memory_candidate_payload"}
      }
    },
    {
      "type": "object",
      "required": ["record_type", "payload"],
      "properties": {
        "record_type": {"const": "memory_write_decision"},
        "payload": {"$ref": "#/$defs/memory_write_decision_payload"}
      }
    },
    {
      "type": "object",
      "required": ["record_type", "payload"],
      "properties": {
        "record_type": {"const": "memory_retrieval"},
        "payload": {"$ref": "#/$defs/memory_retrieval_payload"}
      }
    },
    {
      "type": "object",
      "required": ["record_type", "payload"],
      "properties": {
        "record_type": {"const": "memory_use_receipt"},
        "payload": {"$ref": "#/$defs/memory_use_receipt_payload"}
      }
    },
    {
      "type": "object",
      "required": ["record_type", "payload"],
      "properties": {
        "record_type": {"const": "annotation_event"},
        "payload": {"$ref": "#/$defs/annotation_event_payload"}
      }
    },
    {
      "type": "object",
      "required": ["record_type", "payload"],
      "properties": {
        "record_type": {"const": "attack_counterfactual_trial"},
        "payload": {"$ref": "#/$defs/attack_counterfactual_trial_payload"}
      }
    },
    {
      "type": "object",
      "required": ["record_type", "payload"],
      "properties": {
        "record_type": {"const": "defense_affordance"},
        "payload": {"$ref": "#/$defs/defense_affordance_payload"}
      }
    },
    {
      "type": "object",
      "required": ["record_type", "payload"],
      "properties": {
        "record_type": {"const": "defense_validation_trial"},
        "payload": {"$ref": "#/$defs/defense_validation_trial_payload"}
      }
    },
    {
      "type": "object",
      "required": ["record_type", "payload"],
      "properties": {
        "record_type": {"const": "artifact_manifest"},
        "payload": {"$ref": "#/$defs/artifact_manifest_payload"}
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "nullable_id": {
      "oneOf": [
        {"$ref": "#/$defs/id"},
        {"type": "null"}
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "nullable_timestamp": {
      "oneOf": [
        {"$ref": "#/$defs/timestamp"},
        {"type": "null"}
      ]
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:+-]*$"
    },
    "release_tier": {
      "enum": [
        "public",
        "controlled",
        "sealed"
      ]
    },
    "split": {
      "enum": [
        "build_induction",
        "build_application",
        "selection",
        "confirmation",
        "excluded_pilot"
      ]
    },
    "memory_origin": {
      "enum": [
        "native_adaptive_state",
        "harmonized_external_memory",
        "no_memory_control"
      ],
      "description": "Native state and harmonized external memory are mutually exclusive provenance classes and must never be conflated. The no_memory_control value is reserved for explicit controls."
    },
    "terminal_outcome": {
      "enum": [
        "strict_success",
        "ordinary_failure",
        "safe_completion",
        "refusal",
        "invalid_attacker_output",
        "target_timeout",
        "attacker_timeout",
        "judge_timeout",
        "budget_exhaustion",
        "policy_filter_block",
        "infrastructure_error",
        "cancelled_before_call",
        "no_trajectory",
        "no_memory_fallback",
        "censored"
      ]
    },
    "controlled_content_handle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle_id",
        "content_hash",
        "content_kind",
        "access_tier",
        "redaction_status",
        "publicly_resolvable"
      ],
      "properties": {
        "handle_id": {"$ref": "#/$defs/id"},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "content_kind": {
          "enum": [
            "attacker_input",
            "target_response",
            "redacted_context",
            "memory_abstraction",
            "annotation_evidence",
            "annotation_rationale",
            "defense_invariant",
            "benign_exception",
            "predicted_readaptation",
            "evaluation_probe",
            "compiled_system_prompt",
            "judge_evidence"
          ]
        },
        "access_tier": {
          "enum": ["controlled", "sealed"]
        },
        "redaction_status": {
          "enum": [
            "payload_removed",
            "payload_free_abstraction",
            "access_controlled",
            "sealed"
          ]
        },
        "publicly_resolvable": {"const": false}
      }
    },
    "model_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "exact_revision",
        "provider_id",
        "tokenizer_hash",
        "chat_template_hash"
      ],
      "properties": {
        "model_id": {"$ref": "#/$defs/revision"},
        "exact_revision": {"$ref": "#/$defs/revision"},
        "provider_id": {"$ref": "#/$defs/id"},
        "tokenizer_hash": {"$ref": "#/$defs/sha256"},
        "chat_template_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_call_limit",
        "attacker_call_limit",
        "judge_call_limit",
        "token_limit",
        "wall_time_limit_seconds"
      ],
      "properties": {
        "target_call_limit": {"type": "integer", "minimum": 0},
        "attacker_call_limit": {"type": "integer", "minimum": 0},
        "judge_call_limit": {"type": "integer", "minimum": 0},
        "token_limit": {"type": "integer", "minimum": 0},
        "wall_time_limit_seconds": {"type": "number", "minimum": 0}
      }
    },
    "token_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "cost_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_calls",
        "attacker_calls",
        "judge_calls",
        "tokens",
        "wall_time_seconds",
        "currency",
        "amount"
      ],
      "properties": {
        "target_calls": {"type": "integer", "minimum": 0},
        "attacker_calls": {"type": "integer", "minimum": 0},
        "judge_calls": {"type": "integer", "minimum": 0},
        "tokens": {"$ref": "#/$defs/token_counts"},
        "wall_time_seconds": {"type": "number", "minimum": 0},
        "currency": {"const": "USD"},
        "amount": {"type": "number", "minimum": 0}
      }
    },
    "source_consumption_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_status",
        "source_event_ids",
        "target_response_event_ids",
        "memory_item_hashes",
        "rendered_context_hash",
        "attacker_input_hash",
        "renderer_revision_hash",
        "visibility_policy",
        "captured_at"
      ],
      "properties": {
        "receipt_id": {"$ref": "#/$defs/id"},
        "receipt_status": {
          "enum": [
            "consumed",
            "not_applicable_initial_turn",
            "receipt_failed"
          ]
        },
        "source_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "target_response_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "memory_item_hashes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "rendered_context_hash": {"$ref": "#/$defs/nullable_sha256"},
        "attacker_input_hash": {"$ref": "#/$defs/sha256"},
        "renderer_revision_hash": {"$ref": "#/$defs/sha256"},
        "visibility_policy": {
          "enum": [
            "target_response_only",
            "target_response_and_score",
            "target_response_score_and_policy",
            "none_initial_turn"
          ]
        },
        "captured_at": {"$ref": "#/$defs/timestamp"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"receipt_status": {"const": "consumed"}},
            "required": ["receipt_status"]
          },
          "then": {
            "properties": {
              "source_event_ids": {"minItems": 1},
              "target_response_event_ids": {"minItems": 1},
              "rendered_context_hash": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "receipt_status": {"const": "not_applicable_initial_turn"}
            },
            "required": ["receipt_status"]
          },
          "then": {
            "properties": {
              "target_response_event_ids": {"maxItems": 0},
              "visibility_policy": {"const": "none_initial_turn"}
            }
          }
        }
      ]
    },
    "consumed_response_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_status",
        "source_event_ids",
        "target_response_event_ids",
        "memory_item_hashes",
        "rendered_context_hash",
        "attacker_input_hash",
        "renderer_revision_hash",
        "visibility_policy",
        "captured_at"
      ],
      "properties": {
        "receipt_id": {"$ref": "#/$defs/id"},
        "receipt_status": {"const": "consumed"},
        "source_event_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "target_response_event_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "memory_item_hashes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "rendered_context_hash": {"$ref": "#/$defs/sha256"},
        "attacker_input_hash": {"$ref": "#/$defs/sha256"},
        "renderer_revision_hash": {"$ref": "#/$defs/sha256"},
        "visibility_policy": {
          "enum": [
            "target_response_only",
            "target_response_and_score",
            "target_response_score_and_policy"
          ]
        },
        "captured_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "modality_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_modalities",
        "response_modalities",
        "attachment_hashes"
      ],
      "properties": {
        "input_modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["text", "image", "audio", "video", "structured"]
          }
        },
        "response_modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["text", "image", "audio", "video", "structured"]
          }
        },
        "attachment_hashes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "code"],
      "properties": {
        "axis": {
          "enum": [
            "surface_form",
            "dialogue_steering",
            "response_signal",
            "adaptation_operator",
            "memory_role",
            "evidence_strength",
            "defense_invariant",
            "benign_exception",
            "predicted_adaptation",
            "evaluation_probe"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^(none|uncertain|unmapped|[A-Z][A-Z0-9_.-]{0,63})$"
        }
      }
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/label"}
    },
    "human_initial_annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_handle",
        "labels",
        "evidence_handle_ids",
        "confidence",
        "decision_status",
        "llm_proposal_visible",
        "locked_at",
        "event_hash"
      ],
      "properties": {
        "reviewer_handle": {"$ref": "#/$defs/id"},
        "labels": {"$ref": "#/$defs/labels"},
        "evidence_handle_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "decision_status": {
          "enum": ["labeled", "abstained", "insufficient_context"]
        },
        "llm_proposal_visible": {"const": false},
        "locked_at": {"$ref": "#/$defs/timestamp"},
        "event_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "llm_annotation_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "prompt_hash",
        "decoding_config_hash",
        "seed",
        "codebook_hash",
        "labels",
        "uncertainty",
        "proposal_status",
        "generated_at",
        "event_hash"
      ],
      "properties": {
        "model": {"$ref": "#/$defs/model_revision"},
        "prompt_hash": {"$ref": "#/$defs/sha256"},
        "decoding_config_hash": {"$ref": "#/$defs/sha256"},
        "seed": {"type": "integer", "minimum": 0},
        "codebook_hash": {"$ref": "#/$defs/sha256"},
        "labels": {"$ref": "#/$defs/labels"},
        "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
        "proposal_status": {
          "enum": ["proposed", "abstained", "tool_error"]
        },
        "generated_at": {"$ref": "#/$defs/timestamp"},
        "event_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "human_final_annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_handle",
        "labels",
        "action",
        "reason_code",
        "llm_proposal_visible",
        "locked_at",
        "event_hash"
      ],
      "properties": {
        "reviewer_handle": {"$ref": "#/$defs/id"},
        "labels": {"$ref": "#/$defs/labels"},
        "action": {
          "enum": [
            "accept",
            "retain_human",
            "edit_after_proposal",
            "reject_proposal",
            "abstain_after_proposal"
          ]
        },
        "reason_code": {
          "enum": [
            "agreement",
            "stronger_runtime_evidence",
            "proposal_unsupported",
            "taxonomy_boundary",
            "new_unmapped_type",
            "insufficient_context"
          ]
        },
        "llm_proposal_visible": {"const": true},
        "locked_at": {"$ref": "#/$defs/timestamp"},
        "event_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "independent_vote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_handle",
        "labels",
        "confidence",
        "other_votes_visible",
        "llm_proposal_visible",
        "locked_at",
        "event_hash"
      ],
      "properties": {
        "reviewer_handle": {"$ref": "#/$defs/id"},
        "labels": {"$ref": "#/$defs/labels"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "other_votes_visible": {"const": false},
        "llm_proposal_visible": {"const": false},
        "locked_at": {"$ref": "#/$defs/timestamp"},
        "event_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "adjudicator_handle",
        "final_labels",
        "reason_code",
        "codebook_clause_ids",
        "decided_at",
        "event_hash"
      ],
      "properties": {
        "status": {
          "enum": [
            "adjudicated",
            "not_required_agreement",
            "pending_required"
          ]
        },
        "adjudicator_handle": {"$ref": "#/$defs/nullable_id"},
        "final_labels": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/label"}
        },
        "reason_code": {
          "enum": [
            "evidence_resolution",
            "codebook_resolution",
            "majority_agreement",
            "unresolved",
            "not_required",
            "pending"
          ]
        },
        "codebook_clause_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "decided_at": {"$ref": "#/$defs/nullable_timestamp"},
        "event_hash": {"$ref": "#/$defs/nullable_sha256"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "pending_required"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "adjudicator_handle": {"type": "null"},
              "final_labels": {"maxItems": 0},
              "decided_at": {"type": "null"},
              "event_hash": {"type": "null"},
              "reason_code": {"const": "pending"}
            }
          },
          "else": {
            "properties": {
              "adjudicator_handle": {"$ref": "#/$defs/id"},
              "final_labels": {"minItems": 1},
              "decided_at": {"$ref": "#/$defs/timestamp"},
              "event_hash": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      ]
    },
    "metric_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "estimate",
        "ci_lower",
        "ci_upper",
        "confidence_level",
        "numerator",
        "denominator",
        "direction",
        "resampling_unit"
      ],
      "properties": {
        "metric": {
          "enum": [
            "strict_episode_asr",
            "budgeted_cumulative_asr",
            "harmful_rate",
            "safe_completion_rate",
            "benign_task_accuracy",
            "benign_utility_score",
            "overrefusal_rate",
            "calls_to_success",
            "progress_event_rate",
            "memory_reuse_yield",
            "negative_transfer_rate"
          ]
        },
        "estimate": {"type": "number"},
        "ci_lower": {"type": "number"},
        "ci_upper": {"type": "number"},
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1},
        "direction": {
          "enum": ["positive", "null", "negative", "inconclusive"]
        },
        "resampling_unit": {
          "enum": ["episode", "behavior_cluster", "paired_block"]
        }
      }
    },
    "episode_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "run_id",
        "registered_cell_id",
        "method_id",
        "method_revision",
        "memory_origin",
        "target_model_revision",
        "attacker_model_revision",
        "judge_model_revision",
        "behavior_cluster_handle",
        "split",
        "seed",
        "budget",
        "feedback_visibility",
        "initial_memory_snapshot_hash",
        "final_memory_snapshot_hash",
        "terminal_status",
        "terminal_event_id",
        "cost_receipt"
      ],
      "properties": {
        "episode_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "registered_cell_id": {"$ref": "#/$defs/id"},
        "method_id": {"$ref": "#/$defs/id"},
        "method_revision": {"$ref": "#/$defs/revision"},
